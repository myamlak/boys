# Build outputs
/build/
/build-*/

# Compiler artifacts that land in the source root. The CUDA host compile passes
# /FS without an /Fd, so cl drops its shared program database in the current
# working directory rather than in the build tree; object files land the same way
# when a one-off compile is run from the root. Neither is ever part of the tree.
*.pdb
*.obj

# Visual Studio IDE files
/.vs/

# Python caches and local tooling
__pycache__/
.venv/

# Local working notes, probe output and gate transcripts. These are this
# checkout's own record of work in progress and never ship: the tracked tree
# carries the library, the generated tables and the documents a consumer reads.
/.claude/
/.probe-logs/
/gate.out
